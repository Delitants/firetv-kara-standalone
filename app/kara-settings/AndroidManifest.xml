<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.kara.settingsredirector"
    android:versionCode="5"
    android:versionName="5.0">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="Kara Settings"
        android:theme="@android:style/Theme.DeviceDefault">
        <activity
            android:name="local.kara.settingsredirector.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.settings.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="local.kara.settingsredirector.NetworkActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault" />
        <activity
            android:name="local.kara.settingsredirector.BluetoothActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault" />
        <activity
            android:name="local.kara.settingsredirector.AboutActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault" />
    </application>
</manifest>
